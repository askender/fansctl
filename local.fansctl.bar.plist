<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.fansctl.bar</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/USERNAME/.local/bin/fansctl</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>/tmp/fansctl.bar.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/fansctl.bar.log</string>
</dict>
</plist>
